generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model exhibitions {
  id          String   @id @default(uuid())
  name        String
  description String
  location    String
  country     String
  startDate   DateTime
  endDate     DateTime
  website     String
  industry    String   @default("工业")
  status      String   @default("upcoming")
  keywords    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  news        news[]

  @@index([status])
  @@index([country])
  @@index([industry])
}

model news {
  id           String      @id @default(uuid())
  exhibitionId String
  title        String
  description  String?
  source       String
  url          String      @unique
  publishedAt  DateTime
  createdAt    DateTime    @default(now())
  category     String?
  exhibitions  exhibitions @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
  @@index([publishedAt])
  @@index([category])
}
